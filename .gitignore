# Project virtual environment (and the old virtual-environment-root layout,
# kept so an upgrade from 1.0-1.3 stays clean).
/.venv/
/Include/
/Lib/
/Scripts/
/pyvenv.cfg

# Local secrets, caches, and Python bytecode.
.env
.env.*
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]

# Local conversation logs and reports
*.wav
session-logs/
# Installer bundle output
/dist/
